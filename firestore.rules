rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Hardened Primitives ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'department', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'role', 'department', 'createdAt', 'updatedAt'])
        && data.uid == userId
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.role is string && data.role.size() >= 1 && data.role.size() <= 80
        && data.department is string && data.department.size() >= 1 && data.department.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateContact(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'photoUrl', 'updatedAt'])
        && data.uid == userId
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && data.updatedAt is timestamp;
    }

    function isValidChatSession(data, userId, sessionId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'rolePersona', 'modelId', 'reasoningMode', 'messageCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'rolePersona', 'modelId', 'reasoningMode', 'messageCount', 'createdAt', 'updatedAt'])
        && data.id == sessionId
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.rolePersona in ['triage_specialist', 'radiology_reviewer', 'biomarker_analyst', 'clinical_concierge']
        && data.modelId in ['gemini-4-hydrogen', 'gemini-3.1-flash-lite']
        && data.reasoningMode in ['standard', 'deep', 'fast']
        && data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatMessage(data, userId, sessionId, messageId) {
      return data.keys().hasAll(['id', 'sessionId', 'userId', 'sender', 'text', 'modelId', 'createdAt'])
        && data.keys().hasOnly(['id', 'sessionId', 'userId', 'sender', 'text', 'modelId', 'createdAt'])
        && data.id == messageId
        && data.sessionId == sessionId
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidId(data.id)
        && isValidId(data.sessionId)
        && isValidId(data.userId)
        && data.sender in ['user', 'assistant']
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 16000
        && data.modelId is string && data.modelId.size() >= 1 && data.modelId.size() <= 64
        && data.createdAt is timestamp;
    }

    function isValidTranscription(data, userId, transcriptionId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'transcript', 'mimeType', 'durationSec', 'modelId', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'transcript', 'mimeType', 'durationSec', 'modelId', 'createdAt'])
        && data.id == transcriptionId
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.transcript is string && data.transcript.size() >= 1 && data.transcript.size() <= 20000
        && data.mimeType is string && data.mimeType.size() >= 3 && data.mimeType.size() <= 80
        && (data.durationSec is int || data.durationSec is float) && data.durationSec >= 0 && data.durationSec <= 7200
        && data.modelId == 'gemini-3.5-transcribe'
        && data.createdAt is timestamp;
    }

    function isValidVoiceSession(data, userId, voiceSessionId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'voiceName', 'transcriptSummary', 'turnCount', 'modelId', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'voiceName', 'transcriptSummary', 'turnCount', 'modelId', 'createdAt'])
        && data.id == voiceSessionId
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.voiceName in ['Zephyr', 'Kore', 'Puck', 'Charon', 'Fenrir']
        && data.transcriptSummary is string && data.transcriptSummary.size() >= 1 && data.transcriptSummary.size() <= 16000
        && data.turnCount is int && data.turnCount >= 0 && data.turnCount <= 500
        && data.modelId == 'gemini-3.8-live'
        && data.createdAt is timestamp;
    }

    // --- Collection Rules ---
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'department', 'updatedAt']);
      allow delete: if false;

      match /private/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && docId == 'contact';
        allow list: if false;
        allow create: if isOwner(userId)
          && isValidId(userId)
          && docId == 'contact'
          && isValidPrivateContact(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
          && isValidId(userId)
          && docId == 'contact'
          && isValidPrivateContact(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'photoUrl', 'updatedAt']);
        allow delete: if false;
      }

      match /chatSessions/{sessionId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(sessionId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(sessionId)
          && isValidChatSession(incoming(), userId, sessionId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(sessionId)
          && isValidChatSession(incoming(), userId, sessionId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'rolePersona', 'modelId', 'reasoningMode', 'messageCount', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(sessionId);

        match /messages/{messageId} {
          allow get: if isOwner(userId)
            && isValidId(userId)
            && isValidId(sessionId)
            && isValidId(messageId)
            && get(/databases/$(database)/documents/users/$(userId)/chatSessions/$(sessionId)).data.userId == request.auth.uid;
          allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
          allow create: if isOwner(userId)
            && isValidId(userId)
            && isValidId(sessionId)
            && isValidId(messageId)
            && isValidChatMessage(incoming(), userId, sessionId, messageId)
            && incoming().createdAt == request.time
            && get(/databases/$(database)/documents/users/$(userId)/chatSessions/$(sessionId)).data.userId == request.auth.uid;
          allow update: if false;
          allow delete: if isOwner(userId) && isValidId(userId) && isValidId(sessionId) && isValidId(messageId);
        }
      }

      match /transcriptions/{transcriptionId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(transcriptionId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(transcriptionId)
          && isValidTranscription(incoming(), userId, transcriptionId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(transcriptionId);
      }

      match /voiceSessions/{voiceSessionId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(voiceSessionId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(voiceSessionId)
          && isValidVoiceSession(incoming(), userId, voiceSessionId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(voiceSessionId);
      }
    }
  }
}
