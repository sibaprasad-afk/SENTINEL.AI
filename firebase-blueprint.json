{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated clinician workspace identity metadata stored without PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Authentication user UID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Clinician display name."
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Clinical role title."
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Clinical department."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of profile creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile update."
        }
      },
      "required": ["uid", "displayName", "role", "department", "createdAt", "updatedAt"]
    },
    "UserPrivateContact": {
      "title": "UserPrivateContact",
      "description": "Isolated PII contact document restricted strictly to the owning user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 500
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "Persistent multi-turn Gemini clinical assistant conversation thread.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "rolePersona": {
          "type": "string",
          "enum": ["triage_specialist", "radiology_reviewer", "biomarker_analyst", "clinical_concierge"]
        },
        "modelId": {
          "type": "string",
          "enum": ["gemini-4-hydrogen", "gemini-3.1-flash-lite"]
        },
        "reasoningMode": {
          "type": "string",
          "enum": ["standard", "deep", "fast"]
        },
        "messageCount": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "title", "rolePersona", "modelId", "reasoningMode", "messageCount", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual turn within a Gemini clinical assistant chat session.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sender": {
          "type": "string",
          "enum": ["user", "assistant"]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "modelId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "sessionId", "userId", "sender", "text", "modelId", "createdAt"]
    },
    "TranscriptionRecord": {
      "title": "TranscriptionRecord",
      "description": "Persisted clinical audio dictation transcription generated by gemini-3.5-transcribe.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "transcript": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "mimeType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80
        },
        "durationSec": {
          "type": "number"
        },
        "modelId": {
          "type": "string",
          "enum": ["gemini-3.5-transcribe"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "title", "transcript", "mimeType", "durationSec", "modelId", "createdAt"]
    },
    "VoiceSessionRecord": {
      "title": "VoiceSessionRecord",
      "description": "Persisted real-time voice conversation summary from gemini-3.8-live.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "voiceName": {
          "type": "string",
          "enum": ["Zephyr", "Kore", "Puck", "Charon", "Fenrir"]
        },
        "transcriptSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "turnCount": {
          "type": "integer"
        },
        "modelId": {
          "type": "string",
          "enum": ["gemini-3.8-live"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "title", "voiceName", "transcriptSummary", "turnCount", "modelId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public-safe clinician profile keyed by Firebase Auth UID."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateContact" },
      "description": "Isolated PII contact document restricted to owning clinician."
    },
    "/users/{userId}/chatSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ChatSession" },
      "description": "User-owned multi-turn Gemini assistant chat sessions."
    },
    "/users/{userId}/chatSessions/{sessionId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Ordered message turns belonging to a user chat session."
    },
    "/users/{userId}/transcriptions/{transcriptionId}": {
      "schema": { "$ref": "#/entities/TranscriptionRecord" },
      "description": "User-owned clinical audio dictation transcriptions."
    },
    "/users/{userId}/voiceSessions/{voiceSessionId}": {
      "schema": { "$ref": "#/entities/VoiceSessionRecord" },
      "description": "User-owned Gemini Live voice conversation logs."
    }
  }
}
